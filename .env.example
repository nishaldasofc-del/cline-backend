# --- required ---
GROQ_API_KEY=
# Admin secret (>= 24 chars) held ONLY by your trusted app backend. It mints short-lived per-user
# tokens via POST /v1/admin/user-tokens; phones/clients only ever hold those user tokens.
SERVER_AUTH_TOKEN=

# --- model (any OpenAI-compatible provider) ---
PROVIDER_ID=groq
MODEL_ID=llama-3.3-70b-versatile
# BASE_URL=            # optional override of the provider's default endpoint
# API_KEY=             # optional generic key; wins over GROQ_API_KEY

# --- runtime ---
# PORT is injected by Render. Do not set it there.
PORT=10000
# NODE_OPTIONS=--max-old-space-size=320   # cap V8 heap on 512 MB instances
MAX_ITERATIONS=30
TURN_TIMEOUT_MS=600000
# Render Free (512 MB): keep 1/1. Raise only after checking the "[mem]" log lines.
MAX_CONCURRENT_TURNS=1
MAX_CONCURRENT_TURNS_PER_USER=1
# Idle sessions are evicted from memory after this long (re-opened from Cline's transcript while the process lives).
SESSION_IDLE_MS=900000
# Log rss/heap numbers every N ms (0 = off). Never logs prompts, code or secrets.
MEMORY_LOG_INTERVAL_MS=300000
MAX_BODY_BYTES=131072
MAX_PROJECTS_PER_USER=20
MAX_FILE_BYTES=1048576
USER_TOKEN_MAX_TTL_SECONDS=86400

# --- Termux Sandbox Bridge (sunset-sandbox-v1): the phone connects OUT to wss://<host>/bridge ---
# Shared secret between this server and the Termux agent. >= 24 chars, printable ASCII, and it must NOT equal
# SERVER_AUTH_TOKEN (never reuse the server key). Unset = /bridge is disabled (503); the rest of the server is unaffected.
# Generate one:  openssl rand -base64 32 | tr -d '=+/\n'
# BRIDGE_TOKEN=
# BRIDGE_DEVICE_USERS={"nishal-phone-1":["nishal-test"]}   # who may bind a project to which Termux device (unset = nobody)
# BRIDGE_MAX_DEVICES=16                       # simultaneously connected Termux devices
# BRIDGE_AGENT_MAX_PAYLOAD_BYTES=8388608      # max frame from an agent (a 5 MB file read is ~7 MB as JSON)

# --- bridge / sandbox ---
BRIDGE_OP_TIMEOUT_MS=90000
BRIDGE_MAX_PAYLOAD_BYTES=2097152
# off | allowlist (default) | passthrough. Commands run on the user's device, with no shell.
COMMANDS_MODE=allowlist
# COMMAND_ALLOWLIST=ls,cat,grep,git,node,npm
COMMAND_TIMEOUT_MS=60000
# Server-side URL fetch for the agent (SSRF-guarded). Off by default.
ENABLE_WEB_FETCH=false

# --- storage: EPHEMERAL (Render Free has no persistent disk) ---
# Project/session registries are IN MEMORY and Cline's runtime files go to a per-process dir under this base.
# All of it is lost on restart/redeploy/idle spin-down. User project files live ONLY on the Android device.
# Leave unset on Render (defaults to the OS temp dir, /tmp/cline-agent). Never point it at user data.
# CLINE_DATA_DIR=/tmp/cline-agent
